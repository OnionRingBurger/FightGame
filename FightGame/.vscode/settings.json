    "-I${workspaceFolder}/include/ECS/Component",
    "-I${workspaceFolder}/include/ECS/System",
    "-I${workspaceFolder}/include/ECS/World",
    "-I${workspaceFolder}/include/Game/Core",
    "-I${workspaceFolder}/include/Game/Scene",
    "-I${workspaceFolder}/include/imGui",
    "-I${workspaceFolder}/include/nlohmann",
    "-I${workspaceFolder}/include/Sound",
    "-I${workspaceFolder}/include/Tool/Debug",
    "-I${workspaceFolder}/include/Tool/Math",
    "-I${workspaceFolder}/include/AI",
    "-I${workspaceFolder}/include/EffekseerFiles",
    "-I${workspaceFolder}/include/DirectWrite",
    "-I${workspaceFolder}/Source/imGui",
    "-DWIN32",
    "-D_DEBUG",
    "-D_CONSOLE",
    "-DUNICODE",
    "-D_UNICODE"
