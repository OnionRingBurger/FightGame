{
  "C_Cpp.intelliSenseEngine": "default",
  "C_Cpp.default.compileCommands": "${workspaceFolder}/compile_commands.json",
  "C_Cpp.default.cppStandard": "c++17",
  "C_Cpp.default.compilerPath": "C:/Program Files/Microsoft Visual Studio/2022/Enterprise/VC/Tools/MSVC/14.44.35207/bin/Hostx64/x64/cl.exe",
  "C_Cpp.default.windowsSdkVersion": "10.0.26100.0",
  "clangd.detectExtensionConflicts": false,
  "clangd.diagnostics.suppress": ["*"],
  "clangd.showUnusedWarnings": false,
  "C_Cpp.errorSquiggles": "disabled",
  "clangd.onConfigChanged": "restart",
