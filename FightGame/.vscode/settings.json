    "-std=c++17",
    "--target=x86_64-pc-windows-msvc",
    "-I${workspaceFolder}/include",
    "-I${workspaceFolder}/include/assimp",
    "-I${workspaceFolder}/include/DataManager",
    "-I${workspaceFolder}/include/DirectXTex",
    "-I${workspaceFolder}/include/Drawer",
