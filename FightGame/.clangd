Diagnostics:
  Suppress:
    - '*'
  UnusedIncludes: None
  ClangTidy:
    Remove:
      - '*'

CompileFlags:
  CompilationDatabase: .
  Add:
    - -xc++
    - -w
    - -std=c++17
    - --target=x86_64-pc-windows-msvc
    - -Iinclude
    - -Iinclude/assimp
    - -Iinclude/DataManager
    - -Iinclude/DirectXTex
    - -Iinclude/Drawer
    - -Iinclude/ECS/Core
    - -Iinclude/ECS/Component
    - -Iinclude/ECS/System
    - -Iinclude/ECS/World
    - -Iinclude/Game/Core
    - -Iinclude/Game/Scene
    - -Iinclude/imGui
    - -Iinclude/nlohmann
    - -Iinclude/Sound
    - -Iinclude/Tool/Debug
    - -Iinclude/Tool/Math
    - -Iinclude/AI
    - -Iinclude/EffekseerFiles
    - -Iinclude/DirectWrite
    - -ISource/imGui
    - -DWIN32
    - -D_DEBUG
    - -D_CONSOLE
    - -DUNICODE
    - -D_UNICODE
    - -I
    - "C:/Program Files/Microsoft Visual Studio/2022/Enterprise/VC/Tools/MSVC/14.44.35207/include"
    - -I
    - "C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/ucrt"
    - -I
    - "C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/um"
    - -I
    - "C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/shared"
    - -I
    - "C:/Program Files (x86)/Windows Kits/10/Include/10.0.26100.0/winrt"
